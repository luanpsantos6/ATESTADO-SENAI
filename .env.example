# Supabase > Project Settings > API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# anon key (eyJ...) ou publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Chave SECRETA (somente servidor). Usada pelo admin para criar usuários.
# secret key (sb_secret_...) ou service_role (eyJ...). NUNCA use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-secret-ou-service-role-key
